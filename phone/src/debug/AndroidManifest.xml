<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <receiver
      android:name=".DebugReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="tw.personal.holdings.DEBUG_SEED" />
        <action android:name="tw.personal.holdings.DEBUG_REFRESH" />
      </intent-filter>
    </receiver>
    <receiver
      android:name=".DebugUpdateReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="tw.personal.holdings.DEBUG_UPDATE_URL" />
        <action android:name="tw.personal.holdings.DEBUG_UPDATE_CHECK" />
        <action android:name="tw.personal.holdings.DEBUG_UPDATE_APPLY" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
